@@ -0,0 +1,14 @@
+#!/bin/sh
+# Runs every suite and prints per-suite and total PASS/FAIL counts. Needs: npm install, python3 + openpyxl.
+cd "$(dirname "$0")"; export SE_SAMPLE_DIR="${SE_SAMPLE_DIR:-/tmp/xl/}"
+[ -d "$SE_SAMPLE_DIR" ] || python3 make_sample_xlsx.py "$SE_SAMPLE_DIR"
+tot=0; bad=0
+for f in test_overview.js probe_pbs_widening.js probe_se_import.js test_se_import_core.js test_se_matching_matrix.js \
+         probe_same_day.js test_apps_script_v224.js probe_stage2.js probe_ids.js probe_dobmatch.js \
+         probe_v2128.js probe_v2129.js probe_v21210.js probe_v21211.js probe_v213.js probe_v2134.js probe_v2137.js probe_v2138.js $EXTRA_SUITES; do
+  timeout 300 node "$f" > "/tmp/$f.out" 2>&1
+  p=$(grep -c '^PASS' "/tmp/$f.out"); fl=$(grep -c '^FAIL' "/tmp/$f.out")
+  echo "$f pass=$p fail=$fl"; grep -E '^FAIL|UNCAUGHT' "/tmp/$f.out" | head -3
+  tot=$((tot+p)); bad=$((bad+fl))
+done
+echo "TOTAL pass=$tot fail=$bad"
