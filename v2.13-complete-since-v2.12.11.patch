+  check('C ...a swimmer failing one shows just that value (Ben passes Junior: "Ben Alpha - Boys"; Eve passes Girls: "Eve Delta - Senior")', liFor(r, 'Ben Alpha') === 'Ben Alpha - Boys' && liFor(r, 'Eve Delta') === 'Eve Delta - Senior');
+  check('C ...everyone accounted for exactly once', accounted(r));
