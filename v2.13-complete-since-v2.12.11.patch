+  w.localStorage.setItem('coach_REGIONAL_QT_FULL', fs.readFileSync(path.join(dir, 'regional_qt.json'), 'utf8'));
+} });
+const w = dom.window, doc = w.document;
+const pb = [{ event: '50 Free', course: 'S', time: '30.00', date: '2026-06-01' }];
+const sw = (id, name, gender, year, squad, extra) => ({ id, name, dob: year + '-05-05', gender, source: 'sheet', ...(squad ? { squad } : {}), pbs: pb, ...(extra || {}) });
+const ROSTER = [
+  sw('b1', 'Ben Alpha', 'Boys', 2014, 'Junior'),
+  sw('b2', 'Carl Beta', 'Boys', 2013, 'Senior'),
+  sw('g1', 'Dina Gamma', 'Girls', 2014, 'Junior'),
+  sw('g2', 'Eve Delta', 'Girls', 2012, 'Senior'),
