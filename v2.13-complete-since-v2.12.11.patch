+
+  // E. name search that matches nobody: everyone is listed, none lost
+  r = run('county', { Name: 'zzz' });
+  check('E name search matching nobody: no cards, and all 8 swimmers listed exactly once', r.cards.length === 0 && accounted(r));
+  check('E ...heading says Search: "zzz" and each swimmer reads: name doesn\'t contain "zzz"', liFor(r, 'Ben Alpha') === 'Ben Alpha - name doesn\'t contain "zzz"' && /active filters \(Search: "zzz"\)/.test(r.note));
