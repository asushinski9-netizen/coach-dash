+];
+const set = (p, o) => ['Gender', 'Age', 'Squad', 'Name', 'Stroke', 'Status', 'Course'].forEach(k => { const el = doc.getElementById(p + k); if (el) el.value = (o && o[k]) || ''; });
+const setFormer = (p, v) => { doc.getElementById(p + 'ShowFormer').checked = !!v; };
