+  res('50 Free', 'S', '31.00', '2025-01-01', 'manual'), res('100 Back', 'L', '1:20.00', '2026-02-01', 'gala'), res('50 Back', 'S', '40.00', '', 'gala')];
+const ROSTER = [
+  sw('a', 'Ava Adams', 'Girls', '2013-03-03', 'Junior', '1000001', AVA),
+  sw('b', 'Ben Brown', 'Boys', '2012-06-06', 'Senior', '1000002', gen(1)),
+  sw('c', 'Cal Cole', 'Boys', '2014-01-01', '', '', [], 'local'),
