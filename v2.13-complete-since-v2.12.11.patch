+  sw('m', 'Mal<img src=x onerror="window.__x=true">', 'Girls', '2013-07-07', 'Active', '1000009', gen(1), 'sheet', { id: `m'"<>` }),
+];
+const N = ROSTER.length;
+const bal = (str, tag) => (str.match(new RegExp('<' + tag + '[\\s>]', 'g')) || []).length === (str.match(new RegExp('</' + tag + '>', 'g')) || []).length;
+const cards = () => [...doc.querySelectorAll('#rosterList > .swimmer-card')];
+const nameOf = c => c.querySelector('.swimmer-name-text').textContent;
