+# Builds the two synthetic sample .xlsx exports that test_se_import_core.js reads, from se_sample_rows.json.
+# Usage: python3 make_sample_xlsx.py [outdir]   (default /tmp/xl/ ; then: export SE_SAMPLE_DIR=/tmp/xl/)
+import json, os, sys, openpyxl
+out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/xl'
+os.makedirs(out, exist_ok=True)
+d = json.load(open(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'se_sample_rows.json')))
+for k, n in (('sc', 'SHORT'), ('lc', 'LONG')):
+    wb = openpyxl.Workbook(); ws = wb.active; ws.title = 'Top Times(0)'
+    for r in d[k]: ws.append(r)
+    wb.save(os.path.join(out, f'ALL_COMPETITIVE_{n}_COURSE_-_Copy.xlsx'))
+print('wrote sample files to', out)
